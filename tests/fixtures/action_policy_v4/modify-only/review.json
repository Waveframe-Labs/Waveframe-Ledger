      "clause_id": "policy-clause-e84e8c2e5d698969d21024d69ecc57f65710810e507c490e13094482be67df4e",
      "source_text": "Agents must use role repository-reviewer to modify repository files.\n",
      "proposed_coverage_status": "fully_represented",
      "human_coverage_status": "fully_represented",
      "controls": [
        {
          "candidate_control_id": "candidate-control-25b5e2b43968c36d93e8bca1a5d49d11f82fad9504ae705673aa8d743ec49082",
          "human_confirmed": true,
          "operational_explanation": "The modify action requires repository role 'repository-reviewer'. This role grants no operation. Development validation only; compatible Guard and hosted Cloud activation are pending. An absent action or missing matching allow grants no permission. A matching deny wins within the same action; rules never cross actions. Roles restrict an action and grant no paths. Creation requires one new regular file under an existing parent in the selected workspace, without overwrite or parent creation. Guard must check filesystem state, not caller facts.",
