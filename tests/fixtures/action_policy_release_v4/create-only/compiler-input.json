{
  "schema_version": "action_policy.v1",
  "contract_id": "repository-create-only",
  "contract_version": "3.0.0",
  "action_requirements": {
    "create": {
      "required_role": "repository-maintainer",
      "allow": [
        {
          "match": "prefix",
          "value": "generated/"
        }
      ],
      "deny": [
        {
          "match": "prefix",
          "value": "generated/private/"
        }
      ]
    }
  }
}
