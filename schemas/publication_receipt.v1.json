{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/publication_receipt.v1.json",
  "title": "Publication Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "publication_id",
    "authority_ref",
    "published_at",
    "published_by",
    "bundle_hash",
    "contract_hash",
    "manifest_hash",
    "semantic_artifact_hashes",
    "review_packet_hashes",
    "lineage_continuity",
    "compatibility_posture",
    "readiness_confirmations",
    "publication_notes",
    "semantic_compatibility_warnings",
    "immutable_inputs",
    "non_goals",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "publication_receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "publication_id": {
      "type": ["string", "null"]
    },
    "authority_ref": {
      "type": ["string", "null"]
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "published_by": {
      "type": ["string", "null"]
    },
    "bundle_hash": {
      "type": "string",
      "minLength": 1
    },
    "contract_hash": {
      "type": ["string", "null"]
    },
    "manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "semantic_artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "review_packet_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_commit_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "compiled_contract_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lineage_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_hash_present",
        "compilation_report_hash_present",
        "lineage_complete"
      ],
      "properties": {
        "source_hash_present": {
          "type": "boolean"
        },
        "compilation_report_hash_present": {
          "type": "boolean"
        },
        "lineage_complete": {
          "type": "boolean"
        }
      }
    },
    "compatibility_posture": {
      "type": "object",
      "additionalProperties": true,
      "required": ["compatible"]
    },
    "readiness_confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_diagnostics_reviewed",
        "lineage_validated",
        "continuity_posture_reviewed",
        "replay_implications_reviewed",
        "lifecycle_implications_acknowledged"
      ],
      "properties": {
        "semantic_diagnostics_reviewed": {
          "type": "boolean"
        },
        "lineage_validated": {
          "type": "boolean"
        },
        "continuity_posture_reviewed": {
          "type": "boolean"
        },
        "replay_implications_reviewed": {
          "type": "boolean"
        },
        "lifecycle_implications_acknowledged": {
          "type": "boolean"
        }
      }
    },
    "publication_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_type", "text", "created_at"],
        "properties": {
          "note_type": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "semantic_compatibility_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_profile": {
      "enum": [
        "legacy_provenance_incomplete",
        "customer_policy_provenance_complete_v1"
      ]
    },
    "provenance_bindings": {
      "$ref": "#/$defs/provenanceBindings"
    },
    "immutable_inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["provenance_profile"],
        "properties": {
          "provenance_profile": { "const": "customer_policy_provenance_complete_v1" }
        }
      },
      "then": {
        "required": [
          "semantic_commit_hash",
          "compiled_contract_hash",
          "provenance_bindings"
        ],
        "properties": {
          "semantic_commit_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "compiled_contract_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "immutable_inputs": {
            "required": [
              "provenance_profile",
              "provenance_complete",
              "source_policy_id",
              "source_revision",
              "source_policy_ref",
              "source_snapshot_hash",
              "source_statements_hash",
              "interpretation_id",
              "mapping_hash",
              "resolution_id",
              "resolution_hash",
              "approval_id",
              "approval_record_hash",
              "semantic_commit_id",
              "semantic_commit_hash",
              "compiled_contract_id",
              "compiled_contract_version",
              "compiled_contract_ref",
              "compiled_contract_hash",
              "authority_id",
              "authority_version",
              "authority_ref",
              "authority_identity_hash",
              "version_binding_hash",
              "bundle_hash"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "provenanceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_profile",
        "provenance_complete",
        "source_policy_id",
        "source_revision",
        "source_policy_ref",
        "source_snapshot_hash",
        "source_statements_hash",
        "interpretation_id",
        "mapping_hash",
        "resolution_id",
        "resolution_hash",
        "approval_id",
        "approval_record_hash",
        "semantic_commit_id",
        "semantic_commit_hash",
        "compiled_contract_id",
        "compiled_contract_version",
        "compiled_contract_ref",
        "compiled_contract_hash",
        "authority_id",
        "authority_version",
        "authority_ref",
        "authority_identity_hash",
        "version_binding_hash"
      ],
      "properties": {
        "provenance_profile": { "const": "customer_policy_provenance_complete_v1" },
        "provenance_complete": { "const": true },
        "source_policy_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^@]+$" },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^@]+$" },
        "source_policy_ref": { "type": "string", "minLength": 3, "maxLength": 513, "pattern": "^[^@]+@[^@]+$" },
        "source_snapshot_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source_statements_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "interpretation_id": { "type": "string", "minLength": 1 },
        "mapping_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "resolution_id": { "type": "string", "pattern": "^resolution-set-[a-f0-9]{64}$" },
        "resolution_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approval_id": { "type": "string", "minLength": 1 },
        "approval_record_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "semantic_commit_id": { "type": "string", "minLength": 1 },
        "semantic_commit_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "compiled_contract_id": { "type": "string", "minLength": 1 },
        "compiled_contract_version": { "type": "string", "minLength": 1 },
        "compiled_contract_ref": { "type": "string", "minLength": 1 },
        "compiled_contract_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_version": { "type": "string", "minLength": 1 },
        "authority_ref": { "type": "string", "minLength": 1 },
        "authority_identity_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "version_binding_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
