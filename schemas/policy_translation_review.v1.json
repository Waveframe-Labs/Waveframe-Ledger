{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/policy_translation_review.v1.json",
  "title": "Waveframe Deterministic Policy Translation Review v1",
  "description": "Strict deterministic human-review rendering bound by policy translation approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "proposal_hash", "source_policy_ref", "source_snapshot_hash", "authority_ref", "capability_catalog", "coverage", "clauses", "provider_explanations_used", "review_hash"],
  "properties": {
    "schema_version": {"const": "policy_translation_review.v1"},
    "proposal_id": {"type": "string", "pattern": "^policy-translation-proposal-[a-f0-9]{64}$"},
    "proposal_hash": {"$ref": "#/$defs/sha256"},
    "source_policy_ref": {"type": "string", "minLength": 3},
    "source_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "authority_ref": {"type": "string", "minLength": 3},
    "capability_catalog": {"$ref": "#/$defs/catalogRef"},
    "coverage": {"$ref": "policy_translation_confirmation.v1.json#/$defs/coverage"},
    "clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}},
    "provider_explanations_used": {"const": false},
    "review_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "catalogRef": {"type": "object", "additionalProperties": false, "required": ["catalog_id", "catalog_version", "catalog_hash"], "properties": {"catalog_id": {"type": "string", "minLength": 1}, "catalog_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "catalog_hash": {"$ref": "#/$defs/sha256"}}},
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "source_text", "proposal_status", "human_disposition", "operational_explanation", "remaining_unresolved_bindings", "enforcement_point"],
      "properties": {
        "clause_id": {"type": "string", "pattern": "^policy-clause-[a-f0-9]{64}$"},
        "source_text": {"type": "string", "minLength": 1},
        "proposal_status": {"enum": ["enforceable_fully_bound", "needs_concrete_answer", "integration_dependent", "unsupported", "informational"]},
        "human_disposition": {"type": ["string", "null"], "enum": [null, "enforced", "unsupported", "informational"]},
        "operational_explanation": {"type": "string", "minLength": 1},
        "remaining_unresolved_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "enforcement_point": {"type": ["string", "null"], "enum": [null, "waveframe.guard.repository-change.v1"]}
      }
    }
  }
}
