{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/policy_translation_proposal.v1.json",
  "title": "Waveframe Untrusted Policy Translation Proposal v1",
  "description": "Private untrusted authoring evidence. Schema validity does not establish semantic validity or runtime authority.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "proposal_hash", "source_policy", "authority", "capability_catalog", "clauses", "organizational_bindings", "provider_evidence"],
  "properties": {
    "schema_version": {"const": "policy_translation_proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^policy-translation-proposal-[a-f0-9]{64}$"},
    "proposal_hash": {"$ref": "#/$defs/sha256"},
    "source_policy": {"$ref": "authority_bundle.v2.json#/$defs/sourcePolicy"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "authority_version", "authority_ref"],
      "properties": {
        "authority_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
        "authority_version": {"$ref": "#/$defs/semver"},
        "authority_ref": {"type": "string", "minLength": 3}
      }
    },
    "capability_catalog": {"$ref": "#/$defs/catalogRef"},
    "clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}},
    "organizational_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "provider_evidence": {"$ref": "#/$defs/providerEvidence"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "catalogRef": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_id", "catalog_version", "catalog_hash"],
      "properties": {"catalog_id": {"type": "string", "minLength": 1}, "catalog_version": {"$ref": "#/$defs/semver"}, "catalog_hash": {"$ref": "#/$defs/sha256"}}
    },
    "value": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "source_literal"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "binding_id"], "properties": {"kind": {"const": "organizational_binding"}, "binding_id": {"type": "string", "minLength": 1}}}
      ]
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_control_id", "control_type", "actor_kind", "action", "resource_kind", "fact_id", "operator", "effect", "enforcement_point", "value", "required_runtime_facts"],
      "properties": {
        "candidate_control_id": {"type": "string", "pattern": "^candidate-control-[a-f0-9]{64}$"},
        "control_type": {"enum": ["acting_role", "exact_path_access", "prefix_path_access"]},
        "actor_kind": {"const": "autonomous_agent"}, "action": {"const": "modify"},
        "resource_kind": {"enum": ["repository_change", "repository_path"]},
        "fact_id": {"enum": ["actor.role", "proposal.resource.path"]},
        "operator": {"enum": ["==", "starts_with"]}, "effect": {"enum": ["allow", "deny", "require"]},
        "enforcement_point": {"const": "waveframe.guard.repository-change.v1"},
        "value": {"$ref": "#/$defs/value"},
        "required_runtime_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "index", "start_byte", "end_byte", "clause_bytes_base64", "clause_hash", "status", "candidate_control", "unresolved_binding_ids", "limitation_code", "provider_explanation"],
      "properties": {
        "clause_id": {"type": "string", "pattern": "^policy-clause-[a-f0-9]{64}$"},
        "index": {"type": "integer", "minimum": 0}, "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 1},
        "clause_bytes_base64": {"$ref": "#/$defs/base64"}, "clause_hash": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["enforceable_fully_bound", "needs_concrete_answer", "integration_dependent", "unsupported", "informational"]},
        "candidate_control": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/control"}]},
        "unresolved_binding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limitation_code": {"type": ["string", "null"], "enum": [null, "unavailable_action", "unavailable_actor_kind", "unavailable_runtime_fact", "unavailable_enforcement_point", "unavailable_binding_type", "cross_repository_adapter_required", "other"]},
        "provider_explanation": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_type", "symbol", "question", "status"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
        "binding_type": {"enum": ["repository_exact_path", "repository_path_prefix", "repository_role"]},
        "symbol": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "status": {"const": "unresolved"}
      }
    },
    "providerEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_class", "provider_identifier", "translation_template_version", "translation_template_hash", "request_configuration_id", "request_configuration_hash", "created_at", "candidate_response_base64", "candidate_response_hash", "trust_posture"],
      "properties": {
        "provider_class": {"enum": ["hosted_model", "local_model", "guided_deterministic", "other"]},
        "provider_identifier": {"type": ["string", "null"], "minLength": 1},
        "translation_template_version": {"type": "string", "minLength": 1}, "translation_template_hash": {"$ref": "#/$defs/sha256"},
        "request_configuration_id": {"type": "string", "minLength": 1}, "request_configuration_hash": {"$ref": "#/$defs/sha256"},
        "created_at": {"$ref": "#/$defs/utc"}, "candidate_response_base64": {"$ref": "#/$defs/base64"}, "candidate_response_hash": {"$ref": "#/$defs/sha256"},
        "trust_posture": {"const": "untrusted_authoring_evidence"}
      }
    }
  }
}
