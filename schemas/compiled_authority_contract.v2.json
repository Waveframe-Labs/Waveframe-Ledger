{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/compiled_authority_contract.v2.json",
  "title": "Waveframe Compiled Authority Contract v2",
  "description": "Strict compiled surface currently supported by deterministic domain-pack publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "contract_version", "authority_ref", "compiled_from",
    "authority_requirements", "approval_requirements", "artifact_requirements",
    "stage_requirements", "invariants", "target_requirements", "lineage", "contract_hash"
  ],
  "properties": {
    "schema_version": { "const": "compiled_authority_contract.v2" },
    "contract_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
    "contract_version": { "$ref": "#/$defs/semver" },
    "authority_ref": { "type": "string", "minLength": 3 },
    "compiled_from": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "semantic_commit_id", "semantic_commit_hash", "source_hash", "resolved_interpretation_count"],
      "properties": {
        "schema_version": { "const": "semantic_commit_bundle.v1" },
        "semantic_commit_id": { "type": "string", "minLength": 1 },
        "semantic_commit_hash": { "$ref": "#/$defs/sha256" },
        "source_hash": { "$ref": "#/$defs/sha256" },
        "resolved_interpretation_count": { "type": "integer", "minimum": 0 }
      }
    },
    "authority_requirements": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "required_roles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approval_requirements": { "$ref": "#/$defs/emptyObject" },
    "artifact_requirements": { "$ref": "#/$defs/emptyObject" },
    "stage_requirements": { "$ref": "#/$defs/emptyObject" },
    "invariants": { "$ref": "#/$defs/emptyObject" },
    "target_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "$ref": "#/$defs/targetRules" },
        "deny": { "$ref": "#/$defs/targetRules" }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_hash", "compilation_report_hash", "review_id"],
      "properties": {
        "schema_version": { "const": "governance_authority_lineage.v1" },
        "source_hash": { "$ref": "#/$defs/sha256" },
        "compilation_report_hash": { "$ref": "#/$defs/sha256" },
        "review_id": { "type": "string", "minLength": 1 }
      }
    },
    "contract_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "emptyObject": { "type": "object", "maxProperties": 0 },
    "targetRules": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["match", "value"],
        "properties": {
          "match": { "enum": ["exact", "prefix"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
