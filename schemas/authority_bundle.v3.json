{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/authority_bundle.v3.json",
  "title": "Waveframe Authority Bundle v3",
  "description": "Native multi-control and acknowledged partial-coverage authority publication.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "provenance_complete", "source_policy", "policy_translation_commitment", "constraint_ir", "runtime_fact_schema", "domain_pack", "compiler_binding", "semantic_commit_bundle", "compiled_authority_contract", "authority", "approval_record", "publication_manifest", "provenance_bindings", "bundle_hash"],
  "properties": {
    "schema_version": {"const": "authority_bundle.v3"}, "provenance_complete": {"const": true},
    "source_policy": {"$ref": "authority_bundle.v2.json#/$defs/sourcePolicy"},
    "policy_translation_commitment": {"$ref": "policy_translation_commitment.v1.json"},
    "constraint_ir": {"$ref": "constraint_ir.v1.json"}, "runtime_fact_schema": {"$ref": "runtime_fact_schema.v1.json"},
    "domain_pack": {"$ref": "constraint_ir.v1.json#/$defs/packRef"}, "compiler_binding": {"$ref": "#/$defs/compilerBinding"},
    "semantic_commit_bundle": {"$ref": "semantic_commit_bundle.v1.json"},
    "compiled_authority_contract": {"$ref": "compiled_authority_contract.v2.json"},
    "authority": {"$ref": "#/$defs/authority"}, "approval_record": {"$ref": "#/$defs/approvalRecord"},
    "publication_manifest": {"$ref": "#/$defs/publicationManifest"}, "provenance_bindings": {"$ref": "#/$defs/provenance"},
    "bundle_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "authority_version", "authority_ref", "authority_identity_hash"],
      "properties": {"authority_id": {"type": "string", "minLength": 1}, "authority_version": {"$ref": "#/$defs/semver"}, "authority_ref": {"type": "string", "minLength": 3}, "authority_identity_hash": {"$ref": "#/$defs/sha256"}}
    },
    "compilerComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler_id", "compiler_version"],
      "properties": {"compiler_id": {"type": "string", "minLength": 1}, "compiler_version": {"$ref": "#/$defs/semver"}}
    },
    "loweringComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["lowering_id", "lowering_version"],
      "properties": {"lowering_id": {"type": "string", "minLength": 1}, "lowering_version": {"$ref": "#/$defs/semver"}}
    },
    "emitter": {
      "type": "object", "additionalProperties": false, "required": ["mapping_control_id", "emitter_id"],
      "properties": {"mapping_control_id": {"type": "string", "minLength": 1}, "emitter_id": {"type": "string", "minLength": 1}}
    },
    "compilerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_ir_schema_version", "domain_pack", "grammar_compiler", "compiler_lowering", "control_emitters", "compiled_contract_schema_version", "compiler_binding_hash"],
      "properties": {
        "constraint_ir_schema_version": {"const": "constraint_ir.v1"}, "domain_pack": {"$ref": "constraint_ir.v1.json#/$defs/packRef"},
        "grammar_compiler": {"$ref": "#/$defs/compilerComponent"}, "compiler_lowering": {"$ref": "#/$defs/loweringComponent"},
        "control_emitters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/emitter"}},
        "compiled_contract_schema_version": {"const": "compiled_authority_contract.v2"}, "compiler_binding_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "approvalRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "approved_by", "approved_at", "approved_policy_translation_commitment_hash", "approved_constraint_ir_hash", "approved_semantic_commit_hash", "approval_record_hash"],
      "properties": {
        "approval_id": {"type": "string", "pattern": "^publication-approval-v3-[a-f0-9]{64}$"}, "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"$ref": "#/$defs/utc"}, "approved_policy_translation_commitment_hash": {"$ref": "#/$defs/sha256"},
        "approved_constraint_ir_hash": {"$ref": "#/$defs/sha256"}, "approved_semantic_commit_hash": {"$ref": "#/$defs/sha256"},
        "approval_record_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifestContract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "contract_version", "contract_hash", "source_hash", "path"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1}, "contract_version": {"$ref": "#/$defs/semver"},
        "contract_hash": {"$ref": "#/$defs/sha256"}, "source_hash": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "manifestPath": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "publicationManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "publication_id", "published_at", "published_by", "contracts", "reviews", "snapshots"],
      "properties": {
        "schema_version": {"const": "publication_manifest.v1"}, "publication_id": {"type": "string", "minLength": 1},
        "published_at": {"$ref": "#/$defs/utc"}, "published_by": {"type": "string", "minLength": 1},
        "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/manifestContract"}},
        "reviews": {"type": "array", "items": {"$ref": "#/$defs/manifestPath"}},
        "snapshots": {"type": "array", "items": {"$ref": "#/$defs/manifestPath"}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_snapshot_hash", "source_clauses_hash", "policy_translation_commitment_hash", "confirmed_controls_hash", "acknowledged_residuals_hash", "customer_bindings_hash", "coverage_hash", "capability_catalog_hash", "constraint_ir_hash", "runtime_fact_schema_hash", "domain_pack_hash", "compiler_binding_hash", "semantic_commit_id", "semantic_commit_hash", "semantic_commit_bundle_hash", "compiled_contract_hash", "authority_identity_hash", "approval_record_hash", "publication_manifest_hash"],
      "properties": {
        "source_snapshot_hash": {"$ref": "#/$defs/sha256"}, "source_clauses_hash": {"$ref": "#/$defs/sha256"},
        "policy_translation_commitment_hash": {"$ref": "#/$defs/sha256"}, "confirmed_controls_hash": {"$ref": "#/$defs/sha256"},
        "acknowledged_residuals_hash": {"$ref": "#/$defs/sha256"}, "customer_bindings_hash": {"$ref": "#/$defs/sha256"},
        "coverage_hash": {"$ref": "#/$defs/sha256"}, "capability_catalog_hash": {"$ref": "#/$defs/sha256"},
        "constraint_ir_hash": {"$ref": "#/$defs/sha256"}, "runtime_fact_schema_hash": {"$ref": "#/$defs/sha256"},
        "domain_pack_hash": {"$ref": "#/$defs/sha256"}, "compiler_binding_hash": {"$ref": "#/$defs/sha256"},
        "semantic_commit_id": {"type": "string", "minLength": 1}, "semantic_commit_hash": {"$ref": "#/$defs/sha256"},
        "semantic_commit_bundle_hash": {"$ref": "#/$defs/sha256"}, "compiled_contract_hash": {"$ref": "#/$defs/sha256"},
        "authority_identity_hash": {"$ref": "#/$defs/sha256"}, "approval_record_hash": {"$ref": "#/$defs/sha256"},
        "publication_manifest_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
