{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/policy_mapping_decision.v1.json",
  "title": "Waveframe Policy Mapping Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_document_hash", "statement_id", "start_byte", "end_byte",
    "domain_pack", "control_id", "control_selections", "selected_subject", "selected_role",
    "selected_action", "selected_resource", "selected_effect", "selected_typed_conditions",
    "selected_obligations", "selected_exceptions", "required_runtime_facts", "mapper_identity",
    "mapped_at", "constraint_id", "decision_hash"
  ],
  "properties": {
    "schema_version": { "const": "policy_mapping_decision.v1" },
    "source_document_hash": { "$ref": "#/$defs/sha256" },
    "statement_id": { "type": "string", "pattern": "^statement-[a-f0-9]{64}$" },
    "start_byte": { "type": "integer", "minimum": 0 },
    "end_byte": { "type": "integer", "minimum": 1 },
    "domain_pack": { "$ref": "constraint_ir.v1.json#/$defs/packRef" },
    "control_id": { "type": "string", "minLength": 1 },
    "control_selections": { "type": "object" },
    "selected_subject": { "$ref": "constraint_ir.v1.json#/$defs/selector" },
    "selected_role": { "oneOf": [{ "type": "null" }, { "$ref": "constraint_ir.v1.json#/$defs/selector" }] },
    "selected_action": { "type": "string", "minLength": 1 },
    "selected_resource": { "$ref": "constraint_ir.v1.json#/$defs/resource" },
    "selected_effect": { "enum": ["allow", "deny", "require"] },
    "selected_typed_conditions": { "oneOf": [{ "type": "null" }, { "$ref": "constraint_ir.v1.json#/$defs/condition" }] },
    "selected_obligations": { "$ref": "constraint_ir.v1.json#/$defs/obligations" },
    "selected_exceptions": { "type": "array", "items": { "$ref": "constraint_ir.v1.json#/$defs/exception" } },
    "required_runtime_facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "mapper_identity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mapped_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "constraint_id": { "type": "string", "pattern": "^constraint-[a-f0-9]{64}$" },
    "decision_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
