{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/policy_translation_run_evidence.v1.json",
  "title": "Waveframe Private Policy Translation Run Evidence v1",
  "description": "Optional raw untrusted request and response bytes. This independently deletable artifact is never runtime or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_hash", "request_bytes_base64", "response_bytes_base64", "request_hash", "response_hash", "provider_explanation", "explanation_hash", "trust_posture", "evidence_hash"],
  "properties": {
    "schema_version": {"const": "policy_translation_run_evidence.v1"},
    "run_id": {"type": "string", "pattern": "^translation-run-[a-f0-9]{64}$"},
    "run_hash": {"$ref": "#/$defs/sha256"},
    "request_bytes_base64": {"$ref": "#/$defs/base64"},
    "response_bytes_base64": {"$ref": "#/$defs/base64"},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "response_hash": {"$ref": "#/$defs/sha256"},
    "provider_explanation": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
    "explanation_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "trust_posture": {"const": "private_untrusted_retention_evidence"},
    "evidence_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  }
}
