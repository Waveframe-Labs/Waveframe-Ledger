{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/policy_translation_commitment.v1.json",
  "title": "Waveframe Policy Translation Commitment v1",
  "description": "Provider-free normative commitment to confirmed controls and acknowledged residual meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commitment_id", "commitment_hash", "source_policy_ref", "source_snapshot_hash", "authority_ref", "capability_catalog", "customer_bindings", "clauses", "coverage"],
  "properties": {
    "schema_version": {"const": "policy_translation_commitment.v1"},
    "commitment_id": {"type": "string", "pattern": "^policy-translation-commitment-[a-f0-9]{64}$"},
    "commitment_hash": {"$ref": "#/$defs/sha256"},
    "source_policy_ref": {"type": "string", "minLength": 3},
    "source_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "authority_ref": {"type": "string", "minLength": 3},
    "capability_catalog": {"$ref": "policy_translation_proposal.v1.json#/$defs/catalogRef"},
    "customer_bindings": {"type": "array", "items": {"$ref": "#/$defs/bindingResolution"}},
    "clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}},
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "bindingResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_type", "value", "confirmed_by", "confirmed_at", "resolution_hash"],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1}, "binding_type": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}, "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"$ref": "#/$defs/utc"}, "resolution_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "controlConfirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "candidate_control_id", "confirmed_by", "confirmed_at", "confirmation_hash"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1}, "candidate_control_id": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": "string", "minLength": 1}, "confirmed_at": {"$ref": "#/$defs/utc"},
        "confirmation_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverageDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "coverage_status", "reason_code", "human_reason", "acknowledged_unrepresented", "confirmed_by", "confirmed_at", "decision_hash"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "coverage_status": {"enum": ["fully_represented", "partially_represented", "entirely_unsupported", "informational"]},
        "reason_code": {"type": "string", "minLength": 1}, "human_reason": {"type": ["string", "null"], "minLength": 1},
        "acknowledged_unrepresented": {"type": "boolean"}, "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"$ref": "#/$defs/utc"}, "decision_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "acknowledgment": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "residual_id", "acknowledged_by", "acknowledged_at", "clause_decision_hash", "acknowledgment_hash", "acknowledgment_id"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1}, "residual_id": {"type": "string", "minLength": 1},
        "acknowledged_by": {"type": "string", "minLength": 1}, "acknowledged_at": {"$ref": "#/$defs/utc"},
        "clause_decision_hash": {"$ref": "#/$defs/sha256"}, "acknowledgment_hash": {"$ref": "#/$defs/sha256"},
        "acknowledgment_id": {"type": "string", "pattern": "^residual-acknowledgment-[a-f0-9]{64}$"}
      }
    },
    "residual": {
      "type": "object", "additionalProperties": false,
      "required": ["residual_id", "index", "start_byte", "end_byte", "residual_bytes_base64", "residual_hash", "acknowledgment"],
      "properties": {
        "residual_id": {"type": "string", "minLength": 1}, "index": {"type": "integer", "minimum": 0},
        "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 1},
        "residual_bytes_base64": {"$ref": "#/$defs/base64"}, "residual_hash": {"$ref": "#/$defs/sha256"},
        "acknowledgment": {"$ref": "#/$defs/acknowledgment"}
      }
    },
    "publishedControl": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_control", "resolved_value", "constraint_id", "human_confirmation", "customer_explanation"],
      "properties": {
        "candidate_control": {"$ref": "policy_translation_proposal.v1.json#/$defs/control"},
        "resolved_value": {"type": "string", "minLength": 1}, "constraint_id": {"type": "string", "minLength": 1},
        "human_confirmation": {"$ref": "#/$defs/controlConfirmation"},
        "customer_explanation": {"type": "string", "minLength": 1}
      }
    },
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "index", "start_byte", "end_byte", "clause_bytes_base64", "clause_hash", "customer_coverage_state", "limitation_code", "customer_explanation", "controls", "residuals", "human_coverage_decision"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1}, "index": {"type": "integer", "minimum": 0},
        "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 1},
        "clause_bytes_base64": {"$ref": "#/$defs/base64"}, "clause_hash": {"$ref": "#/$defs/sha256"},
        "customer_coverage_state": {"enum": ["Ready to enforce", "Needs an answer", "Needs a connection", "Partially enforceable", "Not currently enforceable", "Informational"]},
        "limitation_code": {"enum": [null, "unavailable_action", "unavailable_actor_kind", "unavailable_runtime_fact", "unavailable_enforcement_point", "unavailable_binding_type", "cross_repository_adapter_required", "pull_request_approval_not_supported", "other"]}, "customer_explanation": {"type": ["string", "null"], "minLength": 1},
        "controls": {"type": "array", "items": {"$ref": "#/$defs/publishedControl"}},
        "residuals": {"type": "array", "items": {"$ref": "#/$defs/residual"}},
        "human_coverage_decision": {"$ref": "#/$defs/coverageDecision"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["total_clause_count", "full_clause_count", "partial_clause_count", "waiting_clause_count", "needs_answer_clause_count", "needs_connection_clause_count", "unenforced_clause_count", "informational_clause_count", "confirmed_control_count", "acknowledged_residual_count"],
      "properties": {
        "total_clause_count": {"type": "integer", "minimum": 1}, "full_clause_count": {"type": "integer", "minimum": 0},
        "partial_clause_count": {"type": "integer", "minimum": 0}, "waiting_clause_count": {"type": "integer", "minimum": 0},
        "needs_answer_clause_count": {"type": "integer", "minimum": 0}, "needs_connection_clause_count": {"type": "integer", "minimum": 0},
        "unenforced_clause_count": {"type": "integer", "minimum": 0}, "informational_clause_count": {"type": "integer", "minimum": 0},
        "confirmed_control_count": {"type": "integer", "minimum": 0}, "acknowledged_residual_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
