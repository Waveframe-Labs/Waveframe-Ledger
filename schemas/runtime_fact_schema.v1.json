{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.waveframe.dev/runtime_fact_schema.v1.json",
  "title": "Waveframe Runtime Fact Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "schema_version_number", "name", "facts", "schema_hash"],
  "properties": {
    "schema_version": { "const": "runtime_fact_schema.v1" },
    "schema_id": { "$ref": "#/$defs/identity" },
    "schema_version_number": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_id", "type", "enum_values", "canonical_unit", "required", "derivation", "comparison_operators"],
        "properties": {
          "fact_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "type": { "enum": ["boolean", "decimal", "enum", "integer", "string", "string_set", "timestamp"] },
          "enum_values": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }] },
          "canonical_unit": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "derivation": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "additionalProperties": false, "required": ["kind", "field_path"], "properties": {
                "kind": { "const": "proposal_field" },
                "field_path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_-]+)(?:/[A-Za-z0-9_-]+)*$" }
              } }
            ]
          },
          "comparison_operators": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["==", "!=", ">", ">=", "<", "<=", "contains", "starts_with"] } }
        }
      }
    },
    "schema_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
